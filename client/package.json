{
  "name": "client",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "clean:pnpm": "node scripts/clean-pnpm-state.mjs",
    "clean:pnpm:tests": "node scripts/clean-pnpm-state.mjs --tests",
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:audit": "node scripts/audit-e2e-journeys.mjs",
    "test:e2e:critical": "node scripts/run-critical-e2e.mjs J20 J21 J22 J23 J24 J25 J26 J27",
    "test:e2e:critical:all": "node scripts/run-critical-e2e.mjs --all",
    "test:e2e:functional": "node scripts/run-e2e.mjs auth.spec.ts role-access.spec.ts master-data.spec.ts sop-authoring.spec.ts sop-version-history.spec.ts evaluasi-workflow.spec.ts tte-pengesahan.spec.ts arsip-public.spec.ts pdf-verification.spec.ts list-filter-pagination.spec.ts --project=chromium",
    "test:e2e:all": "node scripts/run-e2e.mjs --project=chromium",
    "test:e2e:all:seed": "node scripts/run-e2e.mjs --seed --project=chromium",
    "test:e2e:all-browsers": "node -e \"process.env.E2E_ALL_BROWSERS='true'; const r=require('node:child_process').spawnSync('playwright',['test'],{stdio:'inherit',shell:true,env:process.env}); process.exit(r.status ?? 1)\"",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-query-devtools": "^5.96.1",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.36.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.561.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.4.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.132.0",
    "@tanstack/start-plugin-core": "^1.132.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-react": "latest",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}