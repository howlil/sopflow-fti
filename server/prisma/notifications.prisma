/// Histori notifikasi in-app. Identitas bisnis ditentukan oleh pengajuan,
/// penerima, dan jenis notifikasi; createdAt hanya mencatat waktu kejadian.
model NotifikasiInApp {
  pengajuanEvaluasiId String                 @db.Char(36)
  penggunaId          String                 @db.Char(36)
  jenis               JenisPengingatWhatsApp
  readAt              DateTime?              @db.DateTime(3)
  createdAt           DateTime               @default(now()) @db.DateTime(3)

  @@id([pengajuanEvaluasiId, penggunaId, jenis])
  @@index([penggunaId, readAt, createdAt], map: "NotifikasiInApp_pengguna_read_created_idx")
}

