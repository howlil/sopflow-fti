enum OrganizationalAuthority {
  DEAN
  HEAD_OF_DEPARTMENT
}

/// Deterministic authority assignment for the fixed FTI approval model.
/// `authorityKey` is `DEAN` for faculty scope or
/// `HEAD_OF_DEPARTMENT:<departmentId>` for department scope.
/// Relations are intentionally scalar-only during the OPD-to-FTI migration;
/// database foreign keys are installed by the migration.
model OrganizationalAuthorityAssignment {
  authorityKey String                  @id @db.VarChar(64)
  authority    OrganizationalAuthority
  departmentId String?                 @db.Char(36)
  holderId     String                  @db.Char(36)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([authority, departmentId], map: "OrganizationalAuthorityAssignment_authority_departmentId_idx")
  @@index([holderId], map: "OrganizationalAuthorityAssignment_holderId_idx")
}

/// Audit evidence that the contextual organizational authority approved one
/// Process-bound SOP version. TTE is deliberately separate: approval does not
/// make the SOP BERLAKU by itself.
model ProcessFinalApproval {
  detailSopId     String                  @id @db.Char(36)
  processId       String                  @db.Char(36)
  approvedById    String                  @db.Char(36)
  processReviewId String?                 @db.Char(36)
  authority       OrganizationalAuthority
  authorityKey    String                  @db.VarChar(64)
  approvedAt      DateTime                @default(now())

  @@index([processId, approvedAt], map: "ProcessFinalApproval_processId_approvedAt_idx")
  @@index([approvedById, approvedAt], map: "ProcessFinalApproval_approvedById_approvedAt_idx")
  @@index([authorityKey], map: "ProcessFinalApproval_authorityKey_idx")
  @@index([processReviewId], map: "ProcessFinalApproval_processReviewId_idx")
}
