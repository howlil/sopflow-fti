enum LegacySopRetentionKind {
  HISTORICAL_OPD
  HISTORICAL_UNSCOPED
}

/// Read-only provenance for SOP rows that intentionally remain outside Process ownership.
/// This is historical evidence, never an authorization or discovery source.
model LegacySopRetention {
  sopId                 String                     @id @db.Char(36)
  kind                  LegacySopRetentionKind
  legacyOpdId           String?                    @db.Char(36)
  legacyOpdNameSnapshot String?                    @db.VarChar(100)
  sopTitleSnapshot      String                     @db.VarChar(120)
  reason                String                     @db.VarChar(255)
  capturedAt            DateTime                   @default(now()) @db.DateTime(3)

  @@index([kind], map: "LegacySopRetention_kind_idx")
}
