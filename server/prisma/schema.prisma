generator client {
  provider       = "prisma-client-js"
  output         = "../src/generated/prisma"
  jsModuleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

/// Invariant database (trigger, unique): lihat `prisma/DB-INVARIANTS.md`.

/// =========================
/// MODUL 1 — IDENTITY & ORGANIZATION
/// =========================
model Pengguna {
  penggunaId                String           @id @default(uuid()) @db.Char(36)
  email                     String           @unique @db.VarChar(31)
  nama                      String           @db.VarChar(31)
  kataSandi                 String           @db.Char(60)
  platformRole              PlatformRole     @default(USER)
  nip                       String           @unique @db.Char(18)
  jabatan                   String           @db.VarChar(28)
  pangkat                   String           @db.VarChar(25)
  nohp                      String           @db.VarChar(13)
  sesiTokenVersion          Int              @default(0)
  refreshTokenHash          String?          @db.Char(60)
  refreshTokenExpiresAt     DateTime?
  passwordChangedAt         DateTime?
  ttePinHash                String?          @db.Char(60)
  tteP12Base64              String?          @db.Text
  tteP12PassphraseEncrypted String?          @db.VarChar(255)
  deletedAt                 DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  detailSopDibuat           DetailSOP[]      @relation("SOPDibuatOleh")
  detailSopDiedit           DetailSOP[]      @relation("SOPDieditOleh")
  logEditSop                LogEditSOP[]
  peraturanTerakhirDiedit   Peraturan[]      @relation("PeraturanTerakhirDiedit")
  tandaTangan               RiwayatTandaTangan[]
  processOwned              Process[]        @relation("ProcessOwner")
  processMemberships        ProcessMember[]

  @@index([platformRole, deletedAt], map: "Pengguna_platformRole_deletedAt_idx")
}

model Department {
  departmentId String    @id @default(uuid()) @db.Char(36)
  nama         String    @unique @db.VarChar(100)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  processes    Process[]
}

/// Canonical FTI Process ownership. Active SOPs are owned directly by a Process.
model Process {
  processId    String              @id @default(uuid()) @db.Char(36)
  nama         String              @db.VarChar(120)
  scope        OrganizationalScope
  departmentId String?             @db.Char(36)
  ownerId      String              @db.Char(36)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  department   Department?         @relation(fields: [departmentId], references: [departmentId], onDelete: Restrict)
  owner        Pengguna            @relation("ProcessOwner", fields: [ownerId], references: [penggunaId], onDelete: Restrict)
  members      ProcessMember[]
  sops         SOP[]

  @@index([scope, departmentId], map: "Process_scope_departmentId_idx")
  @@index([ownerId], map: "Process_ownerId_idx")
}

model ProcessMember {
  processId  String   @db.Char(36)
  penggunaId String   @db.Char(36)
  createdAt  DateTime @default(now())
  process    Process  @relation(fields: [processId], references: [processId], onDelete: Cascade)
  pengguna   Pengguna @relation(fields: [penggunaId], references: [penggunaId], onDelete: Restrict)

  @@id([processId, penggunaId])
  @@index([penggunaId], map: "ProcessMember_penggunaId_idx")
}

/// =========================
/// MODUL 1 — REGULATION CATALOG
/// =========================
model Peraturan {
  peraturanId    String    @id @default(uuid()) @db.Char(36)
  nama           String    @db.VarChar(31)
  nomor          String    @db.VarChar(28)
  tahun          Int
  tentang        String    @db.VarChar(73)
  lastEditedById String?   @db.Char(36)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  dasarHukum     DasarHukum[]
  lastEditedBy   Pengguna? @relation("PeraturanTerakhirDiedit", fields: [lastEditedById], references: [penggunaId], onDelete: SetNull)

  @@unique([nomor, tahun])
  @@index([lastEditedById])
}

/// =========================
/// MODUL 2 — SOP AUTHORING
/// =========================
model SOP {
  sopId      String      @id @default(uuid()) @db.Char(36)
  processId  String?     @db.Char(36)
  judul      String      @db.VarChar(42)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  detailSops DetailSOP[]
  /// Null is reserved only for imported archive rows that are not part of the active FTI workflow.
  process    Process?    @relation(fields: [processId], references: [processId], onDelete: Restrict)

  @@index([processId])
}

model DetailSOP {
  detailSopId String @id @default(uuid()) @db.Char(36)
  sopId       String @db.Char(36)

  status                         StatusSOP                        @default(DRAFT)
  versi                          Int                              @default(1)
  nomorSOP                       String                           @unique @db.VarChar(24)
  tanggalPembuatan               DateTime                         @default(now())
  tanggalRevisi                  DateTime?
  tanggalEfektif                 DateTime?
  namaLembaga                    String                           @db.VarChar(28)
  dibuatOlehId                   String?                          @db.Char(36)
  terakhirDieditOlehId           String?                          @db.Char(36)
  revisiDariDetailSopId          String?                          @db.Char(36)
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  revisiDari                     DetailSOP?                       @relation("RevisiDariVersiBerlaku", fields: [revisiDariDetailSopId], references: [detailSopId], onDelete: Restrict)
  revisiMenjadi                  DetailSOP[]                      @relation("RevisiDariVersiBerlaku")
  dasarHukum                     DasarHukum[]
  dibuatOleh                     Pengguna?                        @relation("SOPDibuatOleh", fields: [dibuatOlehId], references: [penggunaId], onDelete: Restrict)
  sop                            SOP                              @relation(fields: [sopId], references: [sopId], onDelete: Cascade)
  terakhirDieditOleh             Pengguna?                        @relation("SOPDieditOleh", fields: [terakhirDieditOlehId], references: [penggunaId], onDelete: Restrict)
  swimlanes                      DetailSOPPelaksana[]
  lampiranPeringatan             LampiranPeringatan[]
  lampiranKualifikasiPelaksanaan LampiranKualifikasiPelaksanaan[]
  lampiranPeralatanPerlengkapan  LampiranPeralatanPerlengkapan[]
  lampiranPencatatanPendataan    LampiranPencatatanPendataan[]
  langkahSOP                     LangkahSOP[]
  logEditSop                     LogEditSOP[]
  relasiSopKeluar                SopTerkait[]                     @relation("RelasiSOP")
  relasiSopMasuk                 SopTerkait[]                     @relation("RelasiSOPTerkait")
  dokumenTte                     DokumenTte[]
  konfigurasiDiagram             KonfigurasiDiagramSOP[]

  @@unique([sopId, versi])
  @@index([sopId, status])
  @@index([sopId, status, versi], map: "DetailSOP_sopId_status_versi_idx")
  @@index([status, updatedAt])
  @@index([status, tanggalEfektif], map: "DetailSOP_status_tanggalEfektif_idx")
  @@index([revisiDariDetailSopId])
}

model LampiranPeringatan {
  lampiranPeringatanId String    @id @default(uuid()) @db.Char(36)
  detailSopId          String    @db.Char(36)
  teks                 String    @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  detailSop            DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId])
}

model LampiranKualifikasiPelaksanaan {
  lampiranKualifikasiPelaksanaanId String    @id @default(uuid()) @db.Char(36)
  detailSopId                      String    @db.Char(36)
  teks                             String    @db.Text
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
  detailSop                        DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId])
}

model LampiranPeralatanPerlengkapan {
  lampiranPeralatanPerlengkapanId String    @id @default(uuid()) @db.Char(36)
  detailSopId                     String    @db.Char(36)
  teks                            String    @db.Text
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  detailSop                       DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId])
}

model LampiranPencatatanPendataan {
  lampiranPencatatanPendataanId String    @id @default(uuid()) @db.Char(36)
  detailSopId                   String    @db.Char(36)
  teks                          String    @db.Text
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  detailSop                     DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId])
}

model DasarHukum {
  detailSopId String    @db.Char(36)
  peraturanId String    @db.Char(36)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  peraturan   Peraturan @relation(fields: [peraturanId], references: [peraturanId])
  detailSop   DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, peraturanId])
  @@index([peraturanId], map: "DasarHukum_peraturanId_idx")
}

model SopTerkait {
  detailSopId        String    @db.Char(36)
  detailSopTerkaitId String    @db.Char(36)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sop                DetailSOP @relation("RelasiSOP", fields: [detailSopId], references: [detailSopId], onDelete: Cascade)
  sopTerkait         DetailSOP @relation("RelasiSOPTerkait", fields: [detailSopTerkaitId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, detailSopTerkaitId])
  @@index([detailSopTerkaitId], map: "SopTerkait_detailSopTerkaitId_idx")
}

model LangkahSOP {
  langkahSopId               String                    @id @default(uuid()) @db.Char(36)
  detailSopId                String                    @db.Char(36)
  kegiatan                   String                    @db.VarChar(55)
  jenis                      JenisLangkahProsedur      @default(KEGIATAN)
  urutan                     Int
  kelengkapan                String                    @db.VarChar(34)
  keluaran                   String                    @db.VarChar(23)
  waktu                      Int
  satuanWaktu                SatuanWaktu
  keterangan                 String                    @db.VarChar(37)
  pelaksanaId                String                    @db.Char(36)
  langkahSelanjutnyaYaId     String?                   @db.Char(36)
  langkahSelanjutnyaTidakId  String?                   @db.Char(36)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  langkahTidak               LangkahSOP?               @relation("LangkahTidak", fields: [langkahSelanjutnyaTidakId], references: [langkahSopId])
  langkahSebelumTidak        LangkahSOP[]              @relation("LangkahTidak")
  langkahYa                  LangkahSOP?               @relation("LangkahYa", fields: [langkahSelanjutnyaYaId], references: [langkahSopId])
  langkahSebelumYa           LangkahSOP[]              @relation("LangkahYa")
  overridePanahSebagaiSumber OverridePanahDiagramSOP[] @relation("OverridePanahDariLangkah")
  overridePanahSebagaiTujuan OverridePanahDiagramSOP[] @relation("OverridePanahKeLangkah")
  pelaksana                  Pelaksana                 @relation(fields: [pelaksanaId], references: [pelaksanaId])
  detailSop                  DetailSOP                 @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@unique([detailSopId, urutan])
  @@index([pelaksanaId], map: "LangkahSOP_pelaksanaId_idx")
  @@index([langkahSelanjutnyaYaId], map: "LangkahSOP_langkahSelanjutnyaYaId_idx")
  @@index([langkahSelanjutnyaTidakId], map: "LangkahSOP_langkahSelanjutnyaTidakId_idx")
}

model Pelaksana {
  pelaksanaId String               @id @default(uuid()) @db.Char(36)
  nama        String               @unique(map: "Pelaksana_nama_key") @db.VarChar(15)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  sopDetails  DetailSOPPelaksana[]
  langkahSOP  LangkahSOP[]
}

model DetailSOPPelaksana {
  detailSopId String    @db.Char(36)
  pelaksanaId String    @db.Char(36)
  urutan      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pelaksana   Pelaksana @relation(fields: [pelaksanaId], references: [pelaksanaId])
  detailSop   DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, pelaksanaId])
  @@index([pelaksanaId], map: "DetailSOPPelaksana_pelaksanaId_idx")
}

/// =========================
/// MODUL 3 — SOP ACTIVITY
/// =========================
model LogEditSOP {
  detailSopId     String                  @db.Char(36)
  penggunaId      String                  @db.Char(36)
  createdAt       DateTime                @default(now()) @db.DateTime(3)
  bagian          BagianSOP               @default(HEADER)
  keterangan      String?                 @db.Text
  sesiChangeCount Int                     @default(1)
  closedAt        DateTime?               @db.DateTime(3)
  updatedAt       DateTime                @updatedAt @db.DateTime(3)
  detailSop       DetailSOP               @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)
  pengguna        Pengguna                @relation(fields: [penggunaId], references: [penggunaId])
  domainFields    LogEditSopDomainField[]

  @@id([detailSopId, penggunaId, createdAt])
  @@index([detailSopId, penggunaId, bagian, closedAt])
  @@index([detailSopId, createdAt])
}

model LogEditSopDomainField {
  detailSopId  String     @db.Char(36)
  penggunaId   String     @db.Char(36)
  logCreatedAt DateTime   @db.DateTime(3)
  domainField  String     @db.VarChar(22)
  logEditSop   LogEditSOP @relation(fields: [detailSopId, penggunaId, logCreatedAt], references: [detailSopId, penggunaId, createdAt], onDelete: Cascade)

  @@id([detailSopId, penggunaId, logCreatedAt, domainField])
}

/// =========================
/// MODUL 4 — TTE
/// =========================
model DokumenTte {
  dokumenTteId       String               @id @default(uuid()) @db.Char(36)
  nomorDokumen       String               @unique @db.VarChar(756)
  jenisDokumen       JenisDokumenTte      @default(SOP_BERLAKU)
  judulDokumen       String               @db.VarChar(2503)
  hashDokumen        String               @db.Char(64)
  versiDokumen       Int                  @default(1)
  pdfPath            String?              @db.Text
  pdfSha256          String?              @db.Char(64)
  pdfSizeBytes       Int?
  pdfGeneratedAt     DateTime?
  pdfPublishedAt     DateTime?
  pdfRevokedAt       DateTime?
  pdfStatus          String?              @db.VarChar(32)
  detailSopId        String               @unique @db.Char(36)
  processId          String               @db.Char(36)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  detailSop          DetailSOP            @relation(fields: [detailSopId], references: [detailSopId], onDelete: Restrict)
  riwayatTandaTangan RiwayatTandaTangan[]

  @@index([jenisDokumen, createdAt], map: "DokumenTte_jenisDokumen_createdAt_idx")
  @@index([jenisDokumen, pdfStatus], map: "DokumenTte_jenisDokumen_pdfStatus_idx")
  @@index([processId], map: "DokumenTte_processId_idx")
}

model RiwayatTandaTangan {
  userId             String                  @db.Char(36)
  dokumenTteId       String                  @db.Char(36)
  authority          OrganizationalAuthority
  signatureValue     String?                 @db.LongText
  signatureAlgorithm String?                 @db.VarChar(13)
  signatureFormat    String?                 @db.VarChar(14)
  certSerialNumber   String?                 @db.VarChar(40)
  certIssuer         String?                 @db.Text
  certSubject        String?                 @db.Text
  certFingerprint    String?                 @db.Char(64)
  certValidFrom      DateTime?
  certValidTo        DateTime?
  ditandatanganiPada DateTime                @default(now())
  dokumenTte         DokumenTte              @relation(fields: [dokumenTteId], references: [dokumenTteId], onDelete: Restrict)
  user               Pengguna                @relation(fields: [userId], references: [penggunaId])

  @@id([userId, dokumenTteId])
  @@unique([dokumenTteId, authority])
}

/// =========================
/// ENUMS
/// =========================
enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum OrganizationalScope {
  FACULTY
  DEPARTMENT
}

enum StatusSOP {
  DRAFT
  PROCESS_REVIEW
  REVISION_REQUIRED
  FINAL_APPROVAL
  TTE_PENDING
  EFFECTIVE
  SUPERSEDED
  REVOKED
}

enum JenisLangkahProsedur {
  AWAL_AKHIR
  KEGIATAN
  KEPUTUSAN
}

enum SatuanWaktu {
  m
  h
  d
  w
  mo
  y
}

enum JenisDokumenTte {
  SOP_BERLAKU
}

enum BagianSOP {
  HEADER
  LANGKAH
  STATUS
  UMPAN_BALIK
  REVIEW
}

enum JenisDiagram {
  FLOWCHART
  BPMN
}

enum CabangDiagram {
  UTAMA
  YA
  TIDAK
}

enum SisiPanahDiagram {
  top
  bottom
  left
  right
}

model KonfigurasiDiagramSOP {
  detailSopId   String                    @db.Char(36)
  jenis         JenisDiagram
  layoutSeed    Int                       @default(0)
  updatedAt     DateTime                  @updatedAt
  overridePanah OverridePanahDiagramSOP[]
  overrideLabel OverrideLabelDiagramSOP[]

  detailSop DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, jenis])
  @@index([detailSopId])
}

model OverridePanahDiagramSOP {
  detailSopId      String           @db.Char(36)
  jenis            JenisDiagram
  dariLangkahSopId String           @db.Char(36)
  keLangkahSopId   String           @db.Char(36)
  cabang           CabangDiagram
  sSide            SisiPanahDiagram
  eSide            SisiPanahDiagram
  startX           Float
  startY           Float
  endX             Float
  endY             Float
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  konfigurasiDiagram KonfigurasiDiagramSOP       @relation(fields: [detailSopId, jenis], references: [detailSopId, jenis], onDelete: Cascade)
  dariLangkah        LangkahSOP                  @relation("OverridePanahDariLangkah", fields: [dariLangkahSopId], references: [langkahSopId], onDelete: Cascade)
  keLangkah          LangkahSOP                  @relation("OverridePanahKeLangkah", fields: [keLangkahSopId], references: [langkahSopId], onDelete: Cascade)
  titikTekuk         TitikTekukPanahDiagramSOP[]

  @@id([detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang])
  @@index([dariLangkahSopId])
  @@index([keLangkahSopId])
}

model TitikTekukPanahDiagramSOP {
  detailSopId      String        @db.Char(36)
  jenis            JenisDiagram
  dariLangkahSopId String        @db.Char(36)
  keLangkahSopId   String        @db.Char(36)
  cabang           CabangDiagram
  urutan           Int
  x                Float
  y                Float

  overridePanah OverridePanahDiagramSOP @relation(fields: [detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang], references: [detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang], onDelete: Cascade)

  @@id([detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang, urutan])
}

model OverrideLabelDiagramSOP {
  detailSopId String       @db.Char(36)
  jenis       JenisDiagram
  kunciLabel  String       @db.VarChar(8)
  posisiX     Float
  posisiY     Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  konfigurasiDiagram KonfigurasiDiagramSOP @relation(fields: [detailSopId, jenis], references: [detailSopId, jenis], onDelete: Cascade)

  @@id([detailSopId, jenis, kunciLabel])
}
