# Minimal environment untuk test lokal/integration dari host.
# Aman untuk dicommit: hanya kredensial disposable test.

NODE_ENV=test
JWT_SECRET=this-is-a-super-secret-key-that-is-at-least-32-characters-long-for-test
TTE_ENCRYPTION_SECRET=this-is-a-dedicated-tte-encryption-secret-for-test-only

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3308
DATABASE_USER=sop_test
DATABASE_PASSWORD=sop_test_password
DATABASE_NAME=sop_biro_organisasi_test

# Test tidak membuat signature baru kecuali suite mengaktifkannya secara eksplisit.
PDF_SIGNING_ENABLED=false
