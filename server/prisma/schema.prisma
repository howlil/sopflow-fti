generator client {
  provider       = "prisma-client-js"
  output         = "../src/generated/prisma"
  jsModuleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

/// Invariant database (trigger, unique): lihat `prisma/DB-INVARIANTS.md`.

/// =========================
/// MODUL 1 — IDENTITAS & ORGANISASI
/// =========================
model Pengguna {
  penggunaId                String           @id @default(uuid()) @db.Char(36)
  email                     String           @unique @db.VarChar(255)
  nama                      String           @db.VarChar(255)
  kataSandi                 String           @db.VarChar(60)
  platformRole              PlatformRole     @default(USER)
  nip                       String           @unique @db.VarChar(32)
  jabatan                   String           @db.VarChar(255)
  pangkat                   String           @db.VarChar(64)
  nohp                      String           @db.VarChar(32)
  sesiTokenVersion          Int              @default(0)
  refreshTokenHash          String?          @db.VarChar(60)
  refreshTokenExpiresAt     DateTime?
  passwordChangedAt         DateTime?
  ttePinHash                String?          @db.VarChar(60)
  tteP12Base64              String?          @db.Text
  tteP12PassphraseEncrypted String?          @db.VarChar(255)
  deletedAt                 DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  detailSopDibuat           DetailSOP[]      @relation("SOPDibuatOleh")
  detailSopDiedit           DetailSOP[]      @relation("SOPDieditOleh")
  logEditSop                LogEditSOP[]
  peraturanTerakhirDiedit   Peraturan[]      @relation("PeraturanTerakhirDiedit")
  tandaTangan               RiwayatTandaTangan[]
  prosesBisnisYangDikelola              ProsesBisnis[]        @relation("PenanggungJawabProsesBisnis")
  keanggotaanProsesBisnis        AnggotaProsesBisnis[]

  @@index([platformRole, deletedAt], map: "Pengguna_platformRole_deletedAt_idx")
}

model Departemen {
  departemenId String    @id @default(uuid()) @db.Char(36) @map("departmentId")
  nama         String    @unique @db.VarChar(100)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  prosesBisnis    ProsesBisnis[]

  @@map("Department")
}

/// Canonical FTI ProsesBisnis ownership. Active SOPs are owned directly by a ProsesBisnis.
model ProsesBisnis {
  prosesBisnisId    String              @id @default(uuid()) @db.Char(36) @map("processId")
  nama         String              @db.VarChar(120)
  lingkup        LingkupOrganisasi @map("scope")
  departemenId String?             @db.Char(36) @map("departmentId")
  penanggungJawabId      String              @db.Char(36) @map("ownerId")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  departemen   Departemen?         @relation(fields: [departemenId], references: [departemenId], onDelete: Restrict)
  penanggungJawab        Pengguna            @relation("PenanggungJawabProsesBisnis", fields: [penanggungJawabId], references: [penggunaId], onDelete: Restrict)
  anggota      AnggotaProsesBisnis[]
  daftarSop         SOP[]

  @@index([lingkup, departemenId], map: "Process_scope_departmentId_idx")
  @@index([penanggungJawabId], map: "Process_ownerId_idx")

  @@map("Process")
}

model AnggotaProsesBisnis {
  prosesBisnisId  String   @db.Char(36) @map("processId")
  penggunaId String   @db.Char(36)
  createdAt  DateTime @default(now())
  prosesBisnis    ProsesBisnis  @relation(fields: [prosesBisnisId], references: [prosesBisnisId], onDelete: Cascade)
  pengguna   Pengguna @relation(fields: [penggunaId], references: [penggunaId], onDelete: Restrict)

  @@id([prosesBisnisId, penggunaId])
  @@index([penggunaId], map: "ProcessMember_penggunaId_idx")

  @@map("ProcessMember")
}

/// =========================
/// MODUL 1 — KATALOG PERATURAN
/// =========================
model Peraturan {
  peraturanId    String    @id @default(uuid()) @db.Char(36)
  nama           String    @db.VarChar(500)
  nomor          String    @db.VarChar(255)
  tahun          Int
  tentang        String    @db.VarChar(2000)
  lastEditedById String?   @db.Char(36)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  dasarHukum     DasarHukum[]
  lastEditedBy   Pengguna? @relation("PeraturanTerakhirDiedit", fields: [lastEditedById], references: [penggunaId], onDelete: SetNull)

  @@unique([nomor, tahun])
  @@index([lastEditedById])
}

/// =========================
/// MODUL 2 — PENYUSUNAN SOP
/// =========================
model SOP {
  sopId      String      @id @default(uuid()) @db.Char(36)
  prosesBisnisId  String?     @db.Char(36) @map("processId")
  judul      String      @db.VarChar(500)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  detailSops DetailSOP[]
  /// Null is reserved only for imported archive rows that are not part of the active FTI workflow.
  prosesBisnis    ProsesBisnis?    @relation(fields: [prosesBisnisId], references: [prosesBisnisId], onDelete: Restrict)

  @@index([prosesBisnisId])
}

model DetailSOP {
  detailSopId String @id @default(uuid()) @db.Char(36)
  sopId       String @db.Char(36)

  status                         StatusSOP                        @default(DRAFT)
  versi                          Int                              @default(1)
  nomorSOP                       String                           @unique @db.VarChar(255)
  tanggalPembuatan               DateTime                         @default(now())
  tanggalRevisi                  DateTime?
  tanggalEfektif                 DateTime?
  namaLembaga                    String                           @db.VarChar(2000)
  dibuatOlehId                   String?                          @db.Char(36)
  terakhirDieditOlehId           String?                          @db.Char(36)
  revisiDariDetailSopId          String?                          @db.Char(36)
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  revisiDari                     DetailSOP?                       @relation("RevisiDariVersiBerlaku", fields: [revisiDariDetailSopId], references: [detailSopId], onDelete: Restrict)
  revisiMenjadi                  DetailSOP[]                      @relation("RevisiDariVersiBerlaku")
  dasarHukum                     DasarHukum[]
  dibuatOleh                     Pengguna?                        @relation("SOPDibuatOleh", fields: [dibuatOlehId], references: [penggunaId], onDelete: Restrict)
  sop                            SOP                              @relation(fields: [sopId], references: [sopId], onDelete: Cascade)
  terakhirDieditOleh             Pengguna?                        @relation("SOPDieditOleh", fields: [terakhirDieditOlehId], references: [penggunaId], onDelete: Restrict)
  swimlanes                      DetailSOPPelaksana[]
  lampiranPeringatan             LampiranPeringatan[]
  lampiranKualifikasiPelaksanaan LampiranKualifikasiPelaksanaan[]
  lampiranPeralatanPerlengkapan  LampiranPeralatanPerlengkapan[]
  lampiranPencatatanPendataan    LampiranPencatatanPendataan[]
  langkahSOP                     LangkahSOP[]
  logEditSop                     LogEditSOP[]
  relasiSopKeluar                SopTerkait[]                     @relation("RelasiSOP")
  relasiSopMasuk                 SopTerkait[]                     @relation("RelasiSOPTerkait")
  dokumenTte                     DokumenTte[]
  konfigurasiDiagram             KonfigurasiDiagramSOP[]

  @@unique([sopId, versi])
  @@index([sopId, status])
  @@index([sopId, status, versi], map: "DetailSOP_sopId_status_versi_idx")
  @@index([status, updatedAt])
  @@index([status, tanggalEfektif], map: "DetailSOP_status_tanggalEfektif_idx")
  @@index([revisiDariDetailSopId])
}

model LampiranPeringatan {
  lampiranPeringatanId String    @id @default(uuid()) @db.Char(36)
  detailSopId          String    @db.Char(36)
  teks                 String    @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  detailSop            DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId])
}

model LampiranKualifikasiPelaksanaan {
  lampiranKualifikasiPelaksanaanId String    @id @default(uuid()) @db.Char(36)
  detailSopId                      String    @db.Char(36)
  teks                             String    @db.Text
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
  detailSop                        DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId])
}

model LampiranPeralatanPerlengkapan {
  lampiranPeralatanPerlengkapanId String    @id @default(uuid()) @db.Char(36)
  detailSopId                     String    @db.Char(36)
  teks                            String    @db.Text
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  detailSop                       DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId])
}

model LampiranPencatatanPendataan {
  lampiranPencatatanPendataanId String    @id @default(uuid()) @db.Char(36)
  detailSopId                   String    @db.Char(36)
  teks                          String    @db.Text
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  detailSop                     DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId])
}

model DasarHukum {
  detailSopId String    @db.Char(36)
  peraturanId String    @db.Char(36)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  peraturan   Peraturan @relation(fields: [peraturanId], references: [peraturanId])
  detailSop   DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, peraturanId])
  @@index([peraturanId], map: "DasarHukum_peraturanId_idx")
}

model SopTerkait {
  detailSopId        String    @db.Char(36)
  detailSopTerkaitId String    @db.Char(36)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sop                DetailSOP @relation("RelasiSOP", fields: [detailSopId], references: [detailSopId], onDelete: Cascade)
  sopTerkait         DetailSOP @relation("RelasiSOPTerkait", fields: [detailSopTerkaitId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, detailSopTerkaitId])
  @@index([detailSopTerkaitId], map: "SopTerkait_detailSopTerkaitId_idx")
}

model LangkahSOP {
  langkahSopId               String                    @id @default(uuid()) @db.Char(36)
  detailSopId                String                    @db.Char(36)
  kegiatan                   String                    @db.VarChar(2000)
  jenis                      JenisLangkahProsedur      @default(KEGIATAN)
  urutan                     Int
  kelengkapan                String                    @db.VarChar(2000)
  keluaran                   String                    @db.VarChar(2000)
  waktu                      Int
  satuanWaktu                SatuanWaktu
  keterangan                 String                    @db.VarChar(2000)
  pelaksanaId                String                    @db.Char(36)
  langkahSelanjutnyaYaId     String?                   @db.Char(36)
  langkahSelanjutnyaTidakId  String?                   @db.Char(36)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  langkahTidak               LangkahSOP?               @relation("LangkahTidak", fields: [langkahSelanjutnyaTidakId], references: [langkahSopId])
  langkahSebelumTidak        LangkahSOP[]              @relation("LangkahTidak")
  langkahYa                  LangkahSOP?               @relation("LangkahYa", fields: [langkahSelanjutnyaYaId], references: [langkahSopId])
  langkahSebelumYa           LangkahSOP[]              @relation("LangkahYa")
  overridePanahSebagaiSumber OverridePanahDiagramSOP[] @relation("OverridePanahDariLangkah")
  overridePanahSebagaiTujuan OverridePanahDiagramSOP[] @relation("OverridePanahKeLangkah")
  pelaksana                  Pelaksana                 @relation(fields: [pelaksanaId], references: [pelaksanaId])
  detailSop                  DetailSOP                 @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@unique([detailSopId, urutan])
  @@index([pelaksanaId], map: "LangkahSOP_pelaksanaId_idx")
  @@index([langkahSelanjutnyaYaId], map: "LangkahSOP_langkahSelanjutnyaYaId_idx")
  @@index([langkahSelanjutnyaTidakId], map: "LangkahSOP_langkahSelanjutnyaTidakId_idx")
}

model Pelaksana {
  pelaksanaId String               @id @default(uuid()) @db.Char(36)
  nama        String               @unique(map: "Pelaksana_nama_key") @db.VarChar(255)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  sopDetails  DetailSOPPelaksana[]
  langkahSOP  LangkahSOP[]
}

model DetailSOPPelaksana {
  detailSopId String    @db.Char(36)
  pelaksanaId String    @db.Char(36)
  urutan      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pelaksana   Pelaksana @relation(fields: [pelaksanaId], references: [pelaksanaId])
  detailSop   DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, pelaksanaId])
  @@index([pelaksanaId], map: "DetailSOPPelaksana_pelaksanaId_idx")
}

/// =========================
/// MODUL 3 — AKTIVITAS SOP
/// =========================
model LogEditSOP {
  detailSopId     String                  @db.Char(36)
  penggunaId      String                  @db.Char(36)
  createdAt       DateTime                @default(now()) @db.DateTime(3)
  bagian          BagianSOP               @default(HEADER)
  keterangan      String?                 @db.Text
  sesiChangeCount Int                     @default(1)
  closedAt        DateTime?               @db.DateTime(3)
  updatedAt       DateTime                @updatedAt @db.DateTime(3)
  detailSop       DetailSOP               @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)
  pengguna        Pengguna                @relation(fields: [penggunaId], references: [penggunaId])
  domainFields    LogEditSopDomainField[]

  @@id([detailSopId, penggunaId, createdAt])
  @@index([detailSopId, penggunaId, bagian, closedAt])
  @@index([detailSopId, createdAt])
}

model LogEditSopDomainField {
  detailSopId  String     @db.Char(36)
  penggunaId   String     @db.Char(36)
  logCreatedAt DateTime   @db.DateTime(3)
  domainField  String     @db.VarChar(22)
  logEditSop   LogEditSOP @relation(fields: [detailSopId, penggunaId, logCreatedAt], references: [detailSopId, penggunaId, createdAt], onDelete: Cascade)

  @@id([detailSopId, penggunaId, logCreatedAt, domainField])
}

/// =========================
/// MODUL 4 — TTE
/// =========================
model DokumenTte {
  dokumenTteId       String               @id @default(uuid()) @db.Char(36)
  nomorDokumen       String               @unique @db.VarChar(756)
  jenisDokumen       JenisDokumenTte      @default(SOP_BERLAKU)
  judulDokumen       String               @db.VarChar(2503)
  hashDokumen        String               @db.Char(64)
  versiDokumen       Int                  @default(1)
  pdfPath            String?              @db.Text
  pdfSha256          String?              @db.Char(64)
  pdfSizeBytes       Int?
  pdfGeneratedAt     DateTime?
  pdfPublishedAt     DateTime?
  pdfRevokedAt       DateTime?
  pdfStatus          String?              @db.VarChar(32)
  detailSopId        String               @unique @db.Char(36)
  prosesBisnisId          String               @db.Char(36) @map("processId")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  detailSop          DetailSOP            @relation(fields: [detailSopId], references: [detailSopId], onDelete: Restrict)
  riwayatTandaTangan RiwayatTandaTangan[]

  @@index([jenisDokumen, createdAt], map: "DokumenTte_jenisDokumen_createdAt_idx")
  @@index([jenisDokumen, pdfStatus], map: "DokumenTte_jenisDokumen_pdfStatus_idx")
  @@index([prosesBisnisId], map: "DokumenTte_processId_idx")
}

model RiwayatTandaTangan {
  userId             String                  @db.Char(36)
  dokumenTteId       String                  @db.Char(36)
  authority          PejabatBerwenang
  signatureValue     String?                 @db.LongText
  signatureAlgorithm String?                 @db.VarChar(13)
  signatureFormat    String?                 @db.VarChar(14)
  certSerialNumber   String?                 @db.VarChar(40)
  certIssuer         String?                 @db.Text
  certSubject        String?                 @db.Text
  certFingerprint    String?                 @db.Char(64)
  certValidFrom      DateTime?
  certValidTo        DateTime?
  ditandatanganiPada DateTime                @default(now())
  dokumenTte         DokumenTte              @relation(fields: [dokumenTteId], references: [dokumenTteId], onDelete: Restrict)
  user               Pengguna                @relation(fields: [userId], references: [penggunaId])

  @@id([userId, dokumenTteId])
  @@unique([dokumenTteId, authority])
}

/// =========================
/// ENUMS
/// =========================
enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum LingkupOrganisasi {
  FACULTY
  DEPARTMENT

  @@map("OrganizationalScope")
}

enum StatusSOP {
  DRAFT
  PROCESS_REVIEW
  REVISION_REQUIRED
  FINAL_APPROVAL
  TTE_PENDING
  EFFECTIVE
  SUPERSEDED
  REVOKED
}

enum JenisLangkahProsedur {
  AWAL_AKHIR
  KEGIATAN
  KEPUTUSAN
}

enum SatuanWaktu {
  m
  h
  d
  w
  mo
  y
}

enum JenisDokumenTte {
  SOP_BERLAKU
}

enum BagianSOP {
  HEADER
  LANGKAH
  STATUS
  UMPAN_BALIK
  REVIEW
}

enum JenisDiagram {
  FLOWCHART
  BPMN
}

enum CabangDiagram {
  UTAMA
  YA
  TIDAK
}

enum SisiPanahDiagram {
  top
  bottom
  left
  right
}

model KonfigurasiDiagramSOP {
  detailSopId   String                    @db.Char(36)
  jenis         JenisDiagram
  layoutSeed    Int                       @default(0)
  updatedAt     DateTime                  @updatedAt
  overridePanah OverridePanahDiagramSOP[]
  overrideLabel OverrideLabelDiagramSOP[]

  detailSop DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, jenis])
  @@index([detailSopId])
}

model OverridePanahDiagramSOP {
  detailSopId      String           @db.Char(36)
  jenis            JenisDiagram
  dariLangkahSopId String           @db.Char(36)
  keLangkahSopId   String           @db.Char(36)
  cabang           CabangDiagram
  sSide            SisiPanahDiagram
  eSide            SisiPanahDiagram
  startX           Float
  startY           Float
  endX             Float
  endY             Float
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  konfigurasiDiagram KonfigurasiDiagramSOP       @relation(fields: [detailSopId, jenis], references: [detailSopId, jenis], onDelete: Cascade)
  dariLangkah        LangkahSOP                  @relation("OverridePanahDariLangkah", fields: [dariLangkahSopId], references: [langkahSopId], onDelete: Cascade)
  keLangkah          LangkahSOP                  @relation("OverridePanahKeLangkah", fields: [keLangkahSopId], references: [langkahSopId], onDelete: Cascade)
  titikTekuk         TitikTekukPanahDiagramSOP[]

  @@id([detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang])
  @@index([dariLangkahSopId])
  @@index([keLangkahSopId])
}

model TitikTekukPanahDiagramSOP {
  detailSopId      String        @db.Char(36)
  jenis            JenisDiagram
  dariLangkahSopId String        @db.Char(36)
  keLangkahSopId   String        @db.Char(36)
  cabang           CabangDiagram
  urutan           Int
  x                Float
  y                Float

  overridePanah OverridePanahDiagramSOP @relation(fields: [detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang], references: [detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang], onDelete: Cascade)

  @@id([detailSopId, jenis, dariLangkahSopId, keLangkahSopId, cabang, urutan])
}

model OverrideLabelDiagramSOP {
  detailSopId String       @db.Char(36)
  jenis       JenisDiagram
  kunciLabel  String       @db.VarChar(8)
  posisiX     Float
  posisiY     Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  konfigurasiDiagram KonfigurasiDiagramSOP @relation(fields: [detailSopId, jenis], references: [detailSopId, jenis], onDelete: Cascade)

  @@id([detailSopId, jenis, kunciLabel])
}

/// =========================
/// PEJABAT BERWENANG & PERSETUJUAN AKHIR
/// =========================
enum PejabatBerwenang {
  DEAN
  HEAD_OF_DEPARTMENT

  @@map("OrganizationalAuthority")
}

/// Deterministic authority assignment for the fixed FTI approval model.
/// `kunciPejabatBerwenang` is `DEAN` for faculty lingkup or
/// `HEAD_OF_DEPARTMENT:<departemenId>` for departemen lingkup.
/// Relations are intentionally scalar-only during the FTI cutover;
/// database foreign keys are installed by the migration.
model PenugasanPejabatBerwenang {
  kunciPejabatBerwenang String                  @id @db.VarChar(64) @map("authorityKey")
  authority    PejabatBerwenang
  departemenId String?                 @db.Char(36) @map("departmentId")
  holderId     String                  @db.Char(36)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([authority, departemenId], map: "OrganizationalAuthorityAssignment_authority_departmentId_idx")
  @@index([holderId], map: "OrganizationalAuthorityAssignment_holderId_idx")

  @@map("OrganizationalAuthorityAssignment")
}

/// Audit evidence that the contextual organizational authority approved one
/// ProsesBisnis-bound SOP version. TTE is deliberately separate: approval does not
/// make the SOP BERLAKU by itself.
model PersetujuanAkhirSOP {
  detailSopId     String                  @id @db.Char(36)
  prosesBisnisId       String                  @db.Char(36) @map("processId")
  approvedById    String                  @db.Char(36)
  pemeriksaanProsesBisnisId String?                 @db.Char(36) @map("processReviewId")
  authority       PejabatBerwenang
  kunciPejabatBerwenang    String                  @db.VarChar(64) @map("authorityKey")
  approvedAt      DateTime                @default(now())

  @@index([prosesBisnisId, approvedAt], map: "ProcessFinalApproval_processId_approvedAt_idx")
  @@index([approvedById, approvedAt], map: "ProcessFinalApproval_approvedById_approvedAt_idx")
  @@index([kunciPejabatBerwenang], map: "ProcessFinalApproval_authorityKey_idx")
  @@index([pemeriksaanProsesBisnisId], map: "ProcessFinalApproval_processReviewId_idx")

  @@map("ProcessFinalApproval")
}

/// =========================
/// PEMERIKSAAN PROSES BISNIS
/// =========================
/// Append-only evidence of a ProsesBisnis Owner decision on a ProsesBisnis-bound SOP version.
/// The status transition, review evidence, and native notification are committed together.
enum KeputusanPemeriksaanProsesBisnis {
  REVISION
  ACCEPT

  @@map("ProcessReviewDecision")
}

model PemeriksaanProsesBisnis {
  pemeriksaanProsesBisnisId String                @id @default(uuid()) @db.Char(36) @map("processReviewId")
  detailSopId     String                @db.Char(36)
  sopId           String                @db.Char(36)
  prosesBisnisId       String                @db.Char(36) @map("processId")
  reviewedById    String                @db.Char(36)
  decision        KeputusanPemeriksaanProsesBisnis
  /// Catatan pemilik proses; wajib untuk keputusan REVISION, opsional untuk ACCEPT.
  catatan         String?               @db.Text
  previousStatus  StatusSOP
  nextStatus      StatusSOP
  createdAt       DateTime              @default(now()) @db.DateTime(3)

  @@index([detailSopId, createdAt], map: "ProcessReview_detail_created_idx")
  @@index([prosesBisnisId, createdAt], map: "ProcessReview_process_created_idx")
  @@index([reviewedById, createdAt], map: "ProcessReview_reviewer_created_idx")

  @@map("ProcessReview")
}

/// =========================
/// NOTIFIKASI PROSES BISNIS
/// =========================
/// Target-native in-app notification history for ProsesBisnis-bound SOP workflow events.
/// Kept separate from archived legacy evaluation/reminder persistence.
enum JenisNotifikasiProsesBisnis {
  PROCESS_OWNER_REVIEW_REQUESTED
  FINAL_APPROVAL_REQUESTED
  PROCESS_REVISION_REQUESTED
  PROCESS_SOP_EFFECTIVE
  PROCESS_SOP_REVOKED

  @@map("ProcessNotificationKind")
}

model NotifikasiProsesBisnis {
  notifikasiProsesBisnisId String                  @id @default(uuid()) @db.Char(36) @map("processNotificationId")
  detailSopId           String                  @db.Char(36)
  sopId                 String                  @db.Char(36)
  prosesBisnisId             String                  @db.Char(36) @map("processId")
  penggunaId            String                  @db.Char(36)
  kind                  JenisNotifikasiProsesBisnis
  title                 String                  @db.VarChar(160)
  preview               String                  @db.VarChar(255)
  body                  String                  @db.Text
  actionHref            String                  @db.VarChar(255)
  readAt                DateTime?               @db.DateTime(3)
  createdAt             DateTime                @default(now()) @db.DateTime(3)

  @@index([penggunaId, readAt, createdAt], map: "ProcessNotification_pengguna_read_created_idx")
  @@index([detailSopId, createdAt], map: "ProcessNotification_detail_created_idx")
  @@index([prosesBisnisId, createdAt], map: "ProcessNotification_process_created_idx")

  @@map("ProcessNotification")
}

/// =========================
/// PENGINGAT PROSES BISNIS
/// =========================
/// Target-native operational reminder state for ProsesBisnis-bound SOP workflow.
///
/// This table is deliberately separate from NotifikasiProsesBisnis history: the
/// former is mutable delivery/retry state, while the latter is in-app event
/// history with read state.
enum JenisPengingatProsesBisnis {
  PROCESS_OWNER_REVIEW
  PROCESS_REVISION
  FINAL_APPROVAL
  TTE

  @@map("ProcessReminderKind")
}

model PengingatProsesBisnis {
  pengingatProsesBisnisId   String              @id @default(uuid()) @db.Char(36) @map("processReminderId")
  detailSopId         String              @db.Char(36)
  sopId               String              @db.Char(36)
  prosesBisnisId           String              @db.Char(36) @map("processId")
  penggunaId          String              @db.Char(36)
  kind                JenisPengingatProsesBisnis
  destinationPhone    String              @db.VarChar(13)
  nextSendAt          DateTime            @db.DateTime(3)
  lastSentAt          DateTime?           @db.DateTime(3)
  consecutiveFailures Int                 @default(0)
  lastErrorKind       String?             @db.VarChar(64)
  lockedUntil         DateTime?           @db.DateTime(3)
  lockToken           String?             @db.Char(36)
  createdAt           DateTime            @default(now()) @db.DateTime(3)
  updatedAt           DateTime            @updatedAt @db.DateTime(3)

  @@unique([detailSopId, penggunaId, kind], map: "ProcessReminder_detail_recipient_kind_key")
  @@index([nextSendAt, lockedUntil], map: "ProcessReminder_due_lock_idx")
  @@index([prosesBisnisId, createdAt], map: "ProcessReminder_process_created_idx")
  @@index([penggunaId, createdAt], map: "ProcessReminder_recipient_created_idx")

  @@map("ProcessReminder")
}

/// =========================
/// ADMINISTRASI PROSES BISNIS
/// =========================
enum StatusKeaktifanProsesBisnis {
  ACTIVE
  ARCHIVED

  @@map("ProcessLifecycleStatus")
}

enum StatusUndanganAnggotaProsesBisnis {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("ProcessInvitationStatus")
}

enum JenisAktivitasProsesBisnis {
  OWNER_AUTHORITY_GRANTED
  OWNER_AUTHORITY_REVOKED
  PROCESS_CREATED
  PROCESS_RENAMED
  PROCESS_ARCHIVED
  MEMBER_ADDED
  MEMBER_REMOVED
  INVITATION_CREATED
  INVITATION_ACCEPTED

  @@map("ProcessAuditEvent")
}

/// Eligibility to create and own ProsesBisnises in one organizational lingkup.
/// Deliberately separate from PlatformRole and PejabatBerwenang/TTE.
model KewenanganPenanggungJawabProsesBisnis {
  kewenanganPenanggungJawabProsesBisnisId String              @id @default(uuid()) @db.Char(36) @map("processOwnerAuthorityId")
  penggunaId              String              @db.Char(36)
  lingkup                    LingkupOrganisasi @map("scope")
  departemenId             String?             @db.Char(36) @map("departmentId")
  /// FACULTY or DEPARTMENT:<departemenId>; makes nullable-departemen uniqueness deterministic.
  kunciLingkup                 String              @db.VarChar(64) @map("scopeKey")
  grantedById              String              @db.Char(36)
  revokedAt                DateTime?           @db.DateTime(3)
  createdAt                DateTime            @default(now()) @db.DateTime(3)
  updatedAt                DateTime            @updatedAt @db.DateTime(3)

  @@unique([penggunaId, kunciLingkup], map: "ProcessOwnerAuthority_user_scopeKey_key")
  @@index([lingkup, departemenId, revokedAt], map: "ProcessOwnerAuthority_scope_active_idx")
  @@index([grantedById, createdAt], map: "ProcessOwnerAuthority_granter_created_idx")

  @@map("ProcessOwnerAuthority")
}

/// Lifecycle is additive so the existing ProsesBisnis/SOP ownership schema remains untouched.
/// Existing ProsesBisnises are backfilled ACTIVE by the migration.
model StatusProsesBisnis {
  prosesBisnisId      String                 @id @db.Char(36) @map("processId")
  status         StatusKeaktifanProsesBisnis @default(ACTIVE)
  archivedAt     DateTime?              @db.DateTime(3)
  archivedReason String?                @db.VarChar(255)
  updatedAt      DateTime               @updatedAt @db.DateTime(3)

  @@index([status, updatedAt], map: "ProcessLifecycle_status_updated_idx")

  @@map("ProcessLifecycle")
}

/// One-time onboarding invitation issued by a ProsesBisnis Owner.
/// The token itself is never persisted; only SHA-256 is stored.
model UndanganAnggotaProsesBisnis {
  undanganAnggotaProsesBisnisId String                  @id @default(uuid()) @db.Char(36) @map("processInvitationId")
  prosesBisnisId           String                  @db.Char(36) @map("processId")
  email               String                  @db.VarChar(31)
  nama                String                  @db.VarChar(31)
  nip                 String                  @db.Char(18)
  jabatan             String                  @db.VarChar(28)
  pangkat             String                  @db.VarChar(25)
  nohp                String                  @db.VarChar(13)
  tokenHash            String                  @unique @db.Char(64)
  status               StatusUndanganAnggotaProsesBisnis @default(PENDING)
  invitedById          String                  @db.Char(36)
  acceptedById         String?                 @db.Char(36)
  expiresAt            DateTime                @db.DateTime(3)
  acceptedAt           DateTime?               @db.DateTime(3)
  createdAt            DateTime                @default(now()) @db.DateTime(3)
  updatedAt            DateTime                @updatedAt @db.DateTime(3)

  @@index([prosesBisnisId, status], map: "ProcessInvitation_process_status_idx")
  @@index([email, status], map: "ProcessInvitation_email_status_idx")
  @@index([invitedById, createdAt], map: "ProcessInvitation_inviter_created_idx")

  @@map("ProcessInvitation")
}

/// Append-only evidence for normal ProsesBisnis administration/self-service changes.
model RiwayatAktivitasProsesBisnis {
  riwayatAktivitasProsesBisnisId String            @id @default(uuid()) @db.Char(36) @map("processAuditId")
  prosesBisnisId      String?           @db.Char(36) @map("processId")
  actorId        String            @db.Char(36)
  event          JenisAktivitasProsesBisnis
  targetUserId   String?           @db.Char(36)
  metadata       Json?
  createdAt      DateTime          @default(now()) @db.DateTime(3)

  @@index([prosesBisnisId, createdAt], map: "ProcessAudit_process_created_idx")
  @@index([actorId, createdAt], map: "ProcessAudit_actor_created_idx")
  @@index([targetUserId, createdAt], map: "ProcessAudit_target_created_idx")

  @@map("ProcessAudit")
}

/// =========================
/// KATALOG PELAKSANA
/// =========================
/// Target-domain metadata for the global reusable Pelaksana catalog.
/// Pelaksana is a global FTI catalog and has no organizational ownership field.
model PelaksanaAuditAttribution {
  pelaksanaId String   @id @db.Char(36)
  createdById String?  @db.Char(36)
  updatedById String?  @db.Char(36)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@index([createdById], map: "PelaksanaAuditAttribution_createdById_idx")
  @@index([updatedById], map: "PelaksanaAuditAttribution_updatedById_idx")
}

/// Stable actor label captured when a Pelaksana is selected into one DetailSOP version.
/// Renaming the global catalog must not rewrite historical SOP actor labels.
model DetailSOPPelaksanaSnapshot {
  detailSopId  String   @db.Char(36)
  pelaksanaId  String   @db.Char(36)
  namaSnapshot String   @db.VarChar(15)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  @@id([detailSopId, pelaksanaId])
  @@index([pelaksanaId], map: "DetailSOPPelaksanaSnapshot_pelaksanaId_idx")
}
